APP_NAME="CTS App"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=

DB_CONNECTION=pgsql
DATABASE_URL=

# Alternatively, configure these individual PostgreSQL fields.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# Vercel URL, without a trailing slash or newline.
FRONTEND_URL=

JWT_SECRET=

# Production: Cloudinary est obligatoire pour les photos de candidats.
CANDIDATE_PHOTO_STORAGE=cloudinary
# Cloudinary: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=cts/candidates

# Utiliser la table cache pour un cache et des limites partagés entre instances.
CACHE_STORE=database
CACHE_LIMITER=database

# À définir uniquement dans Render avant le premier déploiement, puis supprimer.
CTS_ADMIN_EMAIL=
CTS_ADMIN_PASSWORD=
